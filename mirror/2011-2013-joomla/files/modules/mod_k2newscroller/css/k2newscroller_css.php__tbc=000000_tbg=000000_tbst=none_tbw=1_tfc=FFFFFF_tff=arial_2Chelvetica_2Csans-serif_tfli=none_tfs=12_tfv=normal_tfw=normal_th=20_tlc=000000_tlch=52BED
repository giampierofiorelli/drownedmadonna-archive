
.mooquee {
position:absolute;
overflow:hidden;
white-space:nowrap;
margin-top:0px;
margin-right:0px;
margin-bottom:0px;
margin-left:0px;
}
* html .mooquee {
position:relative;
overflow:hidden;
white-space:nowrap;
margin-top:0px;
margin-right:0px;
margin-bottom:0px;
margin-left:0px;
}
* + html .mooquee {
position:relative;
overflow:hidden;
white-space:nowrap;
margin-top:0px;
margin-right:0px;
margin-bottom:0px;
margin-left:0px;
}

.mooquee-text {
position:absolute;
}

.layer_one {
z-index:10000;
}
.layer_two {
z-index:50000;
}
.layer_one, .layer_two {
position:absolute;
width:700px;
height:20px;
line-height:20px;
font-family:arial,helvetica,sans-serif;
font-size:12px;
color:#FFFFFF;
font-weight:normal;
font-variant:normal;
text-transform:uppercase;
letter-spacing:1px;
border:none 1px #000000;
background-color:#000000;
}

.layer_one a:link, .layer_one a:active, .layer_one a:visited,
.layer_two a:link, .layer_two a:active, .layer_two a:visited {	
color:#000000;
text-decoration:none;
}
.layer_one a:hover, .layer_two a:hover {	
color:#52BEDB;
text-decoration:none;
}

.smtclr {
clear:both;
margin-top:0;
}
