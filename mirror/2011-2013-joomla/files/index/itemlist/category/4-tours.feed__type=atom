	<entry>
		<title>Madonna MDNA Tour is once again the week Top Act with sellouts in Paris, London, Edinburgh and Birmingham</title>
		<link rel="alternate" type="text/html" href="http://drownedmadonna.com/index/item/789-madonna-mdna-tour-is-once-again-the-week-top-act-with-sellouts-in-paris-london-edinburgh-and-birmingham.html"/>
		<published>2012-07-25T22:32:15Z</published>
		<updated>2012-07-25T22:32:15Z</updated>
		<id>http://drownedmadonna.com/index/item/789-madonna-mdna-tour-is-once-again-the-week-top-act-with-sellouts-in-paris-london-edinburgh-and-birmingham.html</id>
		<author>
			<name>Giampiero Fiorelli</name>
